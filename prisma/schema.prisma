// Musicart — schema MVP
// Postgres (Railway/Vercel). Los campos *Json son String para portabilidad total.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id     String  @id @default(cuid())
  mbid   String? @unique
  name   String
  bio    String?
  albums Album[]
}

model Album {
  id          String  @id @default(cuid())
  mbid        String? @unique
  title       String
  year        Int
  coverUrl    String?
  durationMin Int?
  difficulty  Int     @default(2) // 1-5 estrellas
  impact      Int     @default(50) // 1-100 impacto cultural (honesto: 100 = hito histórico)
  linksJson   String  @default("{}") // { spotify, appleMusic, youtubeMusic }
  paletteJson String? // swatches extraídos de la portada
  factsJson   String  @default("{}") // facts payload con fuentes (grounding IA)

  artistId   String
  artist     Artist      @relation(fields: [artistId], references: [id])
  dossiers     Dossier[]
  reviews      Review[]
  dailyPicks   DailyPick[]
  dossierViews DossierView[]
  duetPicks    DuetPick[]
}

model Dossier {
  id            String  @id @default(cuid())
  albumId       String
  locale        String  @default("es")
  status        String  @default("draft") // draft | published
  intro         String // resumen narrativo de 2 minutos
  artistStory   String // historia del artista
  whyItMatters  String // por qué fue importante
  questionsJson String  @default("[]") // preguntas de reflexión
  jumpsJson     String  @default("[]") // saltos de descubrimiento [{title, artist, connection}]
  audioJson     String? // { intro: url, artistStory: url, ... } MP3s TTS pre-renderizados

  album      Album       @relation(fields: [albumId], references: [id])
  trackNotes TrackNote[]

  @@unique([albumId, locale])
}

// Cola de generación del catálogo (Fase 2): el curador IA propone álbumes,
// el worker los genera con el pipeline anti-alucinación y deja registro aquí.
model GenerationQueue {
  id        String   @id @default(cuid())
  key       String   @unique // "artista|título" normalizado (anti-duplicados)
  title     String
  artist    String
  priority  Int      @default(100) // menor = se genera antes
  status    String   @default("pending") // pending | running | done | failed
  source    String   @default("curator") // curator | jump | manual
  reason    String? // por qué el curador lo propuso
  result    String? // cómo quedó el dossier: published | draft
  error     String? // último error si falló
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackNote {
  id          String  @id @default(cuid())
  dossierId   String
  position    Int
  title       String
  note        String? // null = track sin nota editorial
  durationSec Int?

  dossier Dossier @relation(fields: [dossierId], references: [id])

  @@unique([dossierId, position])
}

// Perfil anónimo por dispositivo (Fase 3: se fusiona con User al iniciar sesión)
model Profile {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  userId      String?  @unique
  answersJson String   @default("{}") // respuestas de onboarding
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model DailyPick {
  id          String  @id @default(cuid())
  deviceId    String
  userId      String?
  date        String // YYYY-MM-DD
  albumId     String
  reason      String? // "por qué este disco, para ti, hoy"
  mood        String? // ánimo del check-in ("nostálgico", "enérgico"…)
  regenerated Boolean @default(false) // ya se regeneró por cambio de mood (máx. 1)
  returnPick  Boolean @default(false) // Fase 5.6: regreso tras ausencia del ritual
  absenceDays Int? // días sin pick antes de este regreso

  album Album @relation(fields: [albumId], references: [id])
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deviceId, date])
  @@index([userId, date])
}

model Review {
  id          String   @id @default(cuid())
  deviceId    String
  userId      String?
  albumId     String
  rating      Int // 1-10 (puntaje del usuario)
  answersJson String   @default("{}") // reflexión + comentario libre + canción favorita
  createdAt   DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id])
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deviceId, albumId])
  @@index([userId, albumId])
}

// Fase 3 — Auth.js (Google + email magic link)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  reviews           Review[]
  dailyPicks        DailyPick[]
  dossierViews      DossierView[]
  pushSubscriptions PushSubscription[]
  duetAsInviter     DuetPair[] @relation("DuetInviter")
  duetAsPartner     DuetPair[] @relation("DuetPartner")

  stripeCustomerId   String?   @unique
  subscriptionStatus String? // active | trialing | canceled | past_due
  subscriptionEndsAt DateTime?
}

// Fase 5.1 — suscripciones Web Push (recordatorio ritual diario)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceId  String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Fase 5.3 — preguntas al dossier (rate-limited por oyente/día)
model DossierChat {
  id          String   @id @default(cuid())
  listenerKey String
  albumId     String
  dateKey     String // YYYY-MM-DD
  question    String
  createdAt   DateTime @default(now())

  @@index([listenerKey, dateKey])
  @@index([listenerKey, albumId, dateKey])
}

// Fase 5.2 — rebobinada mensual: carta cacheada por oyente y mes
model Rewind {
  id          String   @id @default(cuid())
  listenerKey String // u:<userId> o d:<deviceId>
  monthKey    String // YYYY-MM
  content     String // la carta narrativa
  statsJson   String   @default("{}") // datos crudos que la respaldan
  createdAt   DateTime @default(now())

  @@unique([listenerKey, monthKey])
}

// Fase 5.5 — modo dueto: dos cuentas, un disco compartido a la semana
model DuetPair {
  id          String    @id @default(cuid())
  inviteCode  String    @unique
  userAId     String
  userBId     String?
  status      String    @default("pending") // pending | active
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  userA User       @relation("DuetInviter", fields: [userAId], references: [id], onDelete: Cascade)
  userB User?      @relation("DuetPartner", fields: [userBId], references: [id], onDelete: Cascade)
  picks DuetPick[]
}

model DuetPick {
  id        String   @id @default(cuid())
  pairId    String
  weekKey   String // YYYY-MM-DD del lunes de esa semana
  albumId   String
  reason    String?
  createdAt DateTime @default(now())

  pair  DuetPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  album Album    @relation(fields: [albumId], references: [id])

  @@unique([pairId, weekKey])
}

// Fase 5.4 — hilo musical: la IA conecta reseñas del diario entre sí
model MusicalThread {
  id          String   @id @default(cuid())
  listenerKey String   @unique // u:<userId> o d:<deviceId>
  content     String
  fingerprint String // invalida caché si cambian reseñas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Lecturas de dossier por oyente y mes (freemium: N álbumes únicos/mes en plan gratis).
model DossierView {
  id          String   @id @default(cuid())
  albumId     String
  listenerKey String // u:<userId> o d:<deviceId>
  monthKey    String // YYYY-MM
  createdAt   DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@unique([albumId, listenerKey, monthKey])
  @@index([listenerKey, monthKey])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
