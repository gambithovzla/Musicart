// Musicart — schema MVP
// Postgres (Railway/Vercel). Los campos *Json son String para portabilidad total.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id     String  @id @default(cuid())
  mbid   String? @unique
  name   String
  bio    String?
  albums Album[]
}

model Album {
  id          String  @id @default(cuid())
  mbid        String? @unique
  title       String
  year        Int
  coverUrl    String?
  durationMin Int?
  difficulty  Int     @default(2) // 1-5 estrellas
  impact      Int     @default(50) // 1-100 impacto cultural (honesto: 100 = hito histórico)
  linksJson   String  @default("{}") // { spotify, appleMusic, youtubeMusic }
  paletteJson String? // swatches extraídos de la portada
  factsJson   String  @default("{}") // facts payload con fuentes (grounding IA)
  showcase    Boolean @default(false) // en la vitrina del curador (favoritos del admin)
  showcaseAt  DateTime? // cuándo se puso en la vitrina (orden de exhibición)
  showcaseShelf String? // estante temático de la vitrina (p. ej. "Jazz nocturno")

  artistId   String
  artist     Artist      @relation(fields: [artistId], references: [id])
  dossiers     Dossier[]
  reviews      Review[]
  dailyPicks   DailyPick[]
  dossierViews DossierView[]
  duetPicks    DuetPick[]

  @@index([showcase, showcaseAt])
}

model Dossier {
  id            String  @id @default(cuid())
  albumId       String
  locale        String  @default("es")
  status        String  @default("draft") // draft | published
  intro         String // resumen narrativo de 2 minutos
  artistStory   String // historia del artista
  whyItMatters  String // por qué fue importante
  questionsJson String  @default("[]") // preguntas de reflexión
  jumpsJson     String  @default("[]") // saltos de descubrimiento [{title, artist, connection}]
  impactNote    String? // por qué este impacto cultural, sobre hechos verificados (clicleable)
  wowFactsJson  String  @default("[]") // 2-4 "¿Sabías que…?" verificados contra factsJson
  audioJson     String? // { intro: url, artistStory: url, ... } MP3s TTS pre-renderizados

  album      Album       @relation(fields: [albumId], references: [id])
  trackNotes TrackNote[]

  @@unique([albumId, locale])
}

// Cola de generación del catálogo (Fase 2): el curador IA propone álbumes,
// el worker los genera con el pipeline anti-alucinación y deja registro aquí.
model GenerationQueue {
  id        String   @id @default(cuid())
  key       String   @unique // "artista|título" normalizado (anti-duplicados)
  title     String
  artist    String
  priority  Int      @default(100) // menor = se genera antes
  status    String   @default("pending") // pending | running | done | failed
  source    String   @default("curator") // curator | jump | manual
  reason    String? // por qué el curador lo propuso
  result    String? // cómo quedó el dossier: published | draft
  error     String? // último error si falló
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tope de gasto (Fase 6): cuántos discos NUEVOS se le fabricaron a los oyentes
// hoy. Cuando llega al límite (DAILY_GENERATION_BUDGET), el pick del día cae al
// catálogo existente en vez de generar uno nuevo. No cuenta lo que crea el admin
// ni el worker del catálogo.
model GenerationBudget {
  date  String @id // YYYY-MM-DD
  count Int    @default(0)
}

model TrackNote {
  id          String  @id @default(cuid())
  dossierId   String
  position    Int
  title       String
  note        String? // null = track sin nota editorial
  durationSec Int?

  dossier Dossier @relation(fields: [dossierId], references: [id])

  @@unique([dossierId, position])
}

// Perfil anónimo por dispositivo (Fase 3: se fusiona con User al iniciar sesión)
model Profile {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  userId      String?  @unique
  answersJson String   @default("{}") // respuestas de onboarding
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model DailyPick {
  id          String  @id @default(cuid())
  deviceId    String
  userId      String?
  date        String // YYYY-MM-DD
  albumId     String
  reason      String? // "por qué este disco, para ti, hoy"
  mood        String? // ánimo del check-in ("nostálgico", "enérgico"…)
  regenerated Boolean @default(false) // ya se regeneró por cambio de mood (máx. 1)
  returnPick  Boolean @default(false) // Fase 5.6: regreso tras ausencia del ritual
  absenceDays Int? // días sin pick antes de este regreso

  album Album @relation(fields: [albumId], references: [id])
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deviceId, date])
  @@index([userId, date])
}

model Review {
  id          String   @id @default(cuid())
  deviceId    String
  userId      String?
  albumId     String
  rating      Int // 1-10 (puntaje del usuario)
  answersJson String   @default("{}") // reflexión + comentario libre + canción favorita
  createdAt   DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id])
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deviceId, albumId])
  @@index([userId, albumId])
}

// Fase 3 — Auth.js (Google + email magic link)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  reviews           Review[]
  dailyPicks        DailyPick[]
  dossierViews      DossierView[]
  pushSubscriptions PushSubscription[]
  duetAsInviter     DuetPair[] @relation("DuetInviter")
  duetAsPartner     DuetPair[] @relation("DuetPartner")
  caminos           Camino[]

  stripeCustomerId   String?   @unique
  subscriptionStatus String? // active | trialing | canceled | past_due
  subscriptionEndsAt DateTime?
}

// Fase 5.1 — suscripciones Web Push (recordatorio ritual diario)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceId  String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Fase 5.3 — preguntas al dossier (rate-limited por oyente/día)
model DossierChat {
  id          String   @id @default(cuid())
  listenerKey String
  albumId     String
  dateKey     String // YYYY-MM-DD
  question    String
  createdAt   DateTime @default(now())

  @@index([listenerKey, dateKey])
  @@index([listenerKey, albumId, dateKey])
}

// Memoria personal del oyente: lo que le cuenta al curador sobre lo que escucha
// ("esta canción me fascina", "odio esto"). Alimenta el prompt del disco diario
// para conocerlo cada vez mejor. Denormalizamos título/artista para no depender
// de joins ni de que el álbum siga existiendo. source: "free" (solo memoria,
// gratis) | "chat" (además pidió la respuesta del melómano, con costo de IA).
model ListenerNote {
  id          String   @id @default(cuid())
  deviceId    String?
  userId      String?
  albumId     String? // disco donde lo escribió (referencia suelta, sin relación)
  albumTitle  String? // denormalizado para el prompt y el export
  albumArtist String? // denormalizado
  text        String // el comentario del oyente
  source      String   @default("free") // free | chat
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

// Fase 5.2 — rebobinada mensual: carta cacheada por oyente y mes
model Rewind {
  id          String   @id @default(cuid())
  listenerKey String // u:<userId> o d:<deviceId>
  monthKey    String // YYYY-MM
  content     String // la carta narrativa
  statsJson   String   @default("{}") // datos crudos que la respaldan
  createdAt   DateTime @default(now())

  @@unique([listenerKey, monthKey])
}

// Fase 5.5 — modo dueto: dos cuentas, un disco compartido a la semana
model DuetPair {
  id          String    @id @default(cuid())
  inviteCode  String    @unique
  userAId     String
  userBId     String?
  status      String    @default("pending") // pending | active
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  userA User       @relation("DuetInviter", fields: [userAId], references: [id], onDelete: Cascade)
  userB User?      @relation("DuetPartner", fields: [userBId], references: [id], onDelete: Cascade)
  picks DuetPick[]
}

model DuetPick {
  id        String   @id @default(cuid())
  pairId    String
  weekKey   String // YYYY-MM-DD del lunes de esa semana
  albumId   String
  reason    String?
  createdAt DateTime @default(now())

  pair  DuetPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  album Album    @relation(fields: [albumId], references: [id])

  @@unique([pairId, weekKey])
}

// Fase 5.4 — hilo musical: la IA conecta reseñas del diario entre sí
model MusicalThread {
  id          String   @id @default(cuid())
  listenerKey String   @unique // u:<userId> o d:<deviceId>
  content     String
  fingerprint String // invalida caché si cambian reseñas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Fase 8 — Caminos: "por dónde entro a este género". Una secuencia ORDENADA de
// discos donde cada paso deja el oído listo para el siguiente (la puerta → el
// gancho → el canon → el desvío → la cima). Vive aparte del disco del día: el
// ritual no se toca.
//
// Los pasos viven en `stepsJson` (CaminoStep[] en src/lib/caminos.ts) y no en su
// propia tabla a propósito: nacen todos juntos de UNA propuesta del LLM, se leen
// siempre juntos y solo mutan dos campos por paso (albumId al fabricarlo,
// escuchadoAt al marcarlo). Un modelo aparte solo añadiría joins.
model Camino {
  id        String   @id @default(cuid())
  deviceId  String
  userId    String?
  tema      String // lo que pidió el oyente ("heavy metal", "de Linkin Park a Black Sabbath")
  titulo    String // "El camino al heavy metal"
  intro     String? // la promesa: a dónde te lleva y qué disco te espera al final
  stepsJson String   @default("[]") // CaminoStep[]
  status    String   @default("activo") // activo | completado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
  @@index([userId, status])
}

// Fase 11 — El Atlas: el retrato musical de un país ("Conociendo a…").
//
// Un retrato es de TODOS, no de cada oyente: lo que cuenta de Malí es lo mismo
// para cualquiera que entre. Por eso esto se guarda por país (`code` único) y
// no por deviceId/userId como los Caminos — el segundo que entre a un país lo
// ve al instante y sin gastar un céntimo de IA. Los discos van en `discosJson`
// (DiscoDelRetrato[]); ver src/lib/atlas.ts.
model RetratoPais {
  code   String  @id // ISO 3166-1 alfa-2 (VE, ML, JP…)
  titulo String
  intro  String? // qué cuenta de este país su música

  discosJson String @default("[]") // DiscoDelRetrato[]

  // "listo" = tiene discos que enseñar. "vacio" = no se pudo, y `nota` dice por
  // qué (sin clave de IA, sin presupuesto, o no encontré nada verificable).
  // Guardar el fracaso es deliberado: sin esto, cada visita a un país sin
  // material vuelve a pagar la llamada al curador para volver a fallar.
  status String  @default("listo")
  nota   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Fase 9 — El Salón de la Fama: el índice del canon.
//
// Miles de discos con un puntaje 1-100 COMPARABLE entre sí, que es justo lo que
// `Album.impact` no puede dar: ese lo escribe la IA disco a disco, sin ver a los
// demás, así que un 88 y un 91 de dos días distintos no significan lo mismo.
// Aquí el número NO lo inventa un LLM: sale de señales duras (Wikidata,
// MusicBrainz, Last.fm) y se calibra por percentil contra todo el índice, de
// modo que el puntaje siempre significa "dónde estás parado entre el canon".
//
// Una fila pesa nada y no tiene dossier: el dossier se fabrica perezosamente el
// día que alguien toca ese disco (mismo patrón que los pasos de un Camino), y
// entonces `albumId` apunta al Album del catálogo.
model CanonAlbum {
  id       String  @id @default(cuid())
  key      String  @unique // "artista|título" normalizado (anti-duplicados)
  title    String
  artist   String
  year     Int?
  coverUrl String?

  // El puntaje y sus recibos.
  score        Int     @default(0) // 1-100 final, calibrado por percentil
  raw          Float   @default(0) // prestigio bruto antes de calibrar
  locked       Boolean @default(false) // puntaje fijado a mano por el curador: la ingesta no lo pisa
  signalsJson  String  @default("{}") // señales crudas (recalibrar sin volver a descargar)
  evidenceJson String  @default("[]") // recibos legibles: por qué este número

  // Filtros del Salón (canon con acento: por género, país y década).
  genresJson String  @default("[]")
  country    String? // código ISO-2 del origen del artista
  decade     Int? // 1970, 1980… derivado del año, para filtrar barato

  // Identidad en las fuentes y enlace al catálogo (referencias sueltas, sin
  // relación de Prisma: si el Album se borra, el índice no se rompe).
  mbid       String? @unique // release group de MusicBrainz
  wikidataId String? @unique
  albumId    String? @unique // Album con dossier, si ya se fabricó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([score])
  @@index([decade, score])
  @@index([country, score])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Lecturas de dossier por oyente y mes (freemium: N álbumes únicos/mes en plan gratis).
model DossierView {
  id          String   @id @default(cuid())
  albumId     String
  listenerKey String // u:<userId> o d:<deviceId>
  monthKey    String // YYYY-MM
  createdAt   DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@unique([albumId, listenerKey, monthKey])
  @@index([listenerKey, monthKey])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
